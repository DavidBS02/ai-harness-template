{
  "version": "0.5.0",
  "_doc": "Fuente única de datos del harness. La leen scripts/harness.py, los git hooks, el hook de Claude, el plugin de OpenCode y las Actions. Tras editarla: python3 scripts/harness.py sync",
  "umbrales": {
    "archivos": 5,
    "lineas": 300,
    "trivial_lineas": 20,
    "max_archivos_duro": 40,
    "max_lineas_duro": 1500,
    "_doc": "archivos/lineas: señales de riesgo. max_*_duro: techo real; por encima, el gate exige aprobación humana."
  },
  "zonas": {
    "_doc": "Regex sobre rutas relativas. Calibra por ALCANCE DEL DAÑO, no por dominio (docs/LECCIONES.md §11). Las escribe /descubrir.",
    "alto": [
      "(^|/)(auth|login|session|oauth|permissions?|rbac|iam)(/|$|\\.)",
      "(^|/)(payments?|billing|checkout|invoic\\w*)(/|$|\\.)",
      "(^|/)(secrets?|credentials?|crypto|encryption)(/|$|\\.)|(^|/)\\.env",
      "(^|/)(migrations?|migrate)(/|$|\\.)|\\.sql$",
      "(^|/)(infra|terraform|k8s|helm|deploy)(/|$)|(^|/)Dockerfile|(^|/)docker-compose[^/]*$",
      "^\\.github/",
      "(^|/)deploy[^/]*$"
    ],
    "bajo": [
      "(^|/)(docs?|tests?|__tests__|spec|specs|fixtures?)(/|$)",
      "\\.(md|txt)$",
      "^openspec/",
      "^_bmad-output/",
      "^HANDOFF\\.md$",
      "^\\.harness/(revisiones/|telemetria\\.jsonl$)"
    ]
  },
  "permisos": {
    "_doc": "arquitecto_puede: prefijos que Claude Code puede editar. ejecutor_no_puede: regex que OpenCode no puede editar (tasks.md del change SÍ puede; _bmad-output/digests/ SÍ puede).",
    "arquitecto_puede": [
      "docs/",
      "openspec/",
      "_bmad-output/",
      "_bmad/custom/",
      ".harness/revisiones/",
      ".harness/telemetria.jsonl",
      ".claude/commands/",
      ".claude/rules/",
      ".claude/skills/",
      ".opencode/commands/",
      ".agents/",
      ".cursor/",
      ".github/ISSUE_TEMPLATE/",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/workflows/ci.yml",
      ".github/dependabot.yml",
      "HANDOFF.md",
      "AGENTS.md",
      "CLAUDE.md",
      "README.md",
      "harness.json"
    ],
    "ejecutor_no_puede": [
      "^openspec/specs/",
      "^openspec/config\\.yaml$",
      "^openspec/changes/archive/",
      "^openspec/changes/[^/]+/(proposal|design)\\.md$",
      "^openspec/changes/[^/]+/specs/",
      "^_bmad/",
      "^docs/harness/(MAPA|DELEGACION)\\.md$",
      "^docs/(DECISIONES|LECCIONES|harness-guide)\\.md$",
      "^(AGENTS|CLAUDE)\\.md$",
      "^harness\\.json$",
      "^\\.claude/",
      "^\\.opencode/",
      "^opencode\\.json$",
      "^\\.github/workflows/",
      "^\\.githooks/",
      "^\\.harness/(?!revisiones/|telemetria\\.jsonl$)",
      "^_bmad-output/(?!digests/)",
      "^scripts/",
      "^\\.github/"
    ]
  },
  "agentes": {
    "_doc": "Modelo por agente de OpenCode. 'sync' lo escribe en .opencode/agents/*.md y opencode.json. Verifica los IDs con /models.",
    "build": "opencode-go/glm-5.3",
    "mecanico": "opencode-go/glm-5.3-flash",
    "explorador": "opencode-go/deepseek-v4.1-flash",
    "contexto-largo": "opencode-go/kimi-k3",
    "recolector": "opencode-go/kimi-k3",
    "revisor-gratis": "omniroute/REEMPLAZA-CON-ID-DEL-COMBO-REVISOR",
    "revisor-fuerte": "omniroute/REEMPLAZA-CON-ID-DE-DEEPSEEK-V4-NVIDIA",
    "revisor-bmad": "omniroute/REEMPLAZA-CON-ID-DE-DEEPSEEK-V4-NVIDIA"
  },
  "claude": {
    "decidir": "el modelo más capaz de tu plan (/model)",
    "redactar": "el modelo mediano de tu plan (/model)"
  },
  "clases": {
    "decidir": {
      "herramienta": "claude",
      "modelo": "claude.decidir",
      "que": "Decisiones que se vuelven contrato: SPEC, AD-*, propuesta y publicación de specs"
    },
    "redactar": {
      "herramienta": "claude",
      "modelo": "claude.redactar",
      "que": "Elicitar, redactar y planear sin decidir contrato"
    },
    "recolectar": {
      "herramienta": "opencode",
      "agente": "recolector",
      "que": "Leer mucho y resumir: deja un digest en _bmad-output/digests/ para que Claude decida"
    },
    "revisar": {
      "herramienta": "opencode",
      "agente": "revisor-bmad",
      "que": "Revisión adversarial de artefactos o cambios con otra familia de modelos"
    },
    "ejecutar": {
      "herramienta": "opencode",
      "agente": "build",
      "que": "Implementar un change de OpenSpec"
    },
    "mecanico": {
      "herramienta": "opencode",
      "agente": "mecanico",
      "que": "Tests, docs y trabajo repetitivo"
    },
    "prohibido": {
      "herramienta": null,
      "que": "Implementa fuera de OpenSpec y rompe 'BMAD no ejecuta'. Usa /cambio + /ejecutar-cambio."
    },
    "libre": {
      "herramienta": "cualquiera",
      "que": "Skill genérica fuera del método (documentos, utilidades): se permite en ambas herramientas"
    }
  },

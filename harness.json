      "^\\.githooks/",
      "^\\.github/workflows/",
      "^\\.github/CODEOWNERS$",
      "^\\.github/dependabot\\.yml$",
      "^\\.claude/settings(\\.local)?\\.json$",
      "^\\.opencode/plugins/",
      "^\\.opencode/agents/",
      "^opencode\\.json$",
      "^\\.harness/(contenedor/|versiones\\.json$|openspec-config\\.base\\.yaml$)"
    ],
    "arquitecto_puede": [
      "^harness\\.json$",
      "^\\.github/workflows/ci\\.yml$",
      "^\\.github/dependabot\\.yml$"
    ]
  },

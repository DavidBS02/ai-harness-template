  "skills_por_prefijo": {
    "openspec-": "decidir",
    "bmad-": "redactar"
  },
  "niveles": {
    "0": "Directo: ≤ trivial_lineas y riesgo bajo. Rama fix/<slug>, sin change, sin issue, solo CI.",
    "1": "Ligero: una capacidad, riesgo bajo o medio. Change (proposal + tasks), rama feat/<id>, sin issue, Revisión 1, Claude propone y juzga en una sesión.",
    "2": "Estándar: varias capacidades o riesgo medio. Change completo, issue, rama feat/<n>-<id>, revisiones según riesgo.",
    "3": "Completo: iniciativa nueva o riesgo alto. BMAD antes, change, issue y las tres revisiones."
  },
  "placeholders": [
    {
      "file": "AGENTS.md",
      "marker": "<",
      "descripcion": "proyecto, stack, comandos, puntos de entrada, rutas prohibidas"
    },
    {
      "file": "harness.json",
      "marker": "REEMPLAZA-CON-ID",
      "descripcion": "IDs de modelo de OmniRoute (combo revisor y DeepSeek V4)"
    },
    {
      "file": "openspec/config.yaml",
      "marker": "<qué es",
      "descripcion": "context del proyecto (lo siembra el primer change o /init-harness)"
    },
    {
      "file": ".github/workflows/ci.yml",
      "marker": "Reemplaza este paso",
      "descripcion": "instalar + lint + tests del stack"
    }
  ],
  "skills_libres_doc": "Las skills no listadas en 'skills' se BLOQUEAN en ambas herramientas hasta clasificarlas con /clasificar-skill en Claude Code.",
  "skills_por_prefijo_doc": "Solo sugerencia para analizar-skill; NO enruta.",
  "skills_motivos": {},
  "secretos": {
    "_doc": "Rutas y comandos que ningún agente puede leer ni imprimir. Guardias de Claude y OpenCode, contenedor (enmascarados) y pre-commit.",
    "rutas": [
      "(^|/)\\.env$",
      "(^|/)\\.env\\.[^/]+$",
      "(^|/)\\.(ssh|aws|kube|gnupg)(/|$)",
      "(^|/)\\.config/gh(/|$)",
      "(^|/)\\.docker/config\\.json$",
      "(^|/)\\.(npmrc|netrc|pypirc|git-credentials)$",
      "\\.(pem|key|p12|pfx|keystore|jks)$",
      "(^|/)id_(rsa|dsa|ecdsa|ed25519)$",
      "(^|/)(credentials|service-account[^/]*|client_secret[^/]*)\\.json$"
    ],
    "excepto": [
      "(^|/)\\.env\\.(example|sample|template)$",
      "\\.pub$"
    ],
    "globs": [
      "\\.env(?!\\.(example|sample|template))",
      "\\.(ssh|aws|kube|gnupg)\\b",
      "id_(rsa|dsa|ecdsa|ed25519)\\b",
      "\\.(pem|p12|pfx)\\b"
    ],
    "comandos": [
      "\\bprintenv\\b",
      "(^|[\\s;&|(])(env|set|export\\s+-p|declare\\s+-x)(\\s*$|\\s*[;&|)])",
      "\\$\\{?[A-Za-z_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_KEY|APIKEY|PRIVATE_KEY|CREDENTIAL)[A-Za-z_]*\\}?",
      "/proc/[^\\s]*/environ",
      "\\bgh\\s+auth\\s+token\\b",
      "\\bsecurity\\s+find-(generic|internet)-password\\b"
    ],
    "contenido": [
      "gh[pousr]_[A-Za-z0-9]{36,}",
      "github_pat_[A-Za-z0-9_]{22,}",
      "sk-ant-[A-Za-z0-9_-]{20,}",
      "\\bsk-[A-Za-z0-9]{32,}",
      "AKIA[0-9A-Z]{16}",
      "AIza[0-9A-Za-z_-]{35}",
      "xox[baprs]-[A-Za-z0-9-]{10,}",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    ]
  },
  "control_plane": {
    "_doc": "Archivos que controlan a los agentes. Riesgo alto siempre; el gate exige aprobación humana en el PR; ningún agente los edita salvo 'arquitecto_puede'.",
    "rutas": [
      "^harness\\.json$",
      "^scripts/(harness|guardia_claude|test_harness)\\.py$",
      "^scripts/(arq|ejec|ejec-contenedor)$",

{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "mcp__codebase-memory__index_repository",
      "mcp__codebase-memory__delete_project",
      "mcp__codebase-memory__manage_adr",
      "mcp__codebase-memory__ingest_traces"
    ]
  },
  "enabledMcpjsonServers": ["codebase-memory"],
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "./.env",
        "~/.ssh",
        "~/.config/gh",
        "~/.aws"
      ],
      "denyWrite": [
        "./harness.json",
        "./scripts",
        "./.githooks",
        "./.github/workflows",
        "./.claude/settings.json",
        "./.opencode/plugins",
        "./.opencode/agents",
        "./opencode.json",
        "./.harness/contenedor",
        "./.harness/versiones.json",
        "./.mcp.json",
        "./.cbmignore"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|Skill|Read|Grep|Glob|NotebookRead|LS",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}/scripts/guardia_claude.py\" || exit 2"
          }
        ]
      }
    ]
  }
}

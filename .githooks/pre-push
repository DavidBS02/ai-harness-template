#!/usr/bin/env bash
set -uo pipefail
. "$(dirname "$0")/_lib.sh"
[ "$OVERRIDE" = "1" ] && exit 0
[ "$ROL" = "humano" ] && exit 0
while read -r _ _ remote_ref _; do
  case "$remote_ref" in refs/heads/main|refs/heads/master)
    rechazo "los agentes no hacen push a ${remote_ref#refs/heads/}." "push de la rama feat/<issue>-<slug> + gh pr create; el merge lo decide /juzgar-pr." ;;
  esac
done
exit 0

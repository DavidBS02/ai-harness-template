{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (capas gratis)",
      "options": {
        "baseURL": "{env:OMNIROUTE_BASE_URL}",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {}
    }
  },
  "mcp": {
    "codebase-memory": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec \"$(git rev-parse --show-toplevel)/scripts/cbm\""
      ],
      "enabled": true
    }
  },
  "tools": {
    "codebase-memory_*": false
  },
  "agent": {
    "build": {
      "tools": {
        "codebase-memory_*": true
      }
    },
    "explorador": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    },
    "recolector": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    },
    "contexto-largo": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    },
    "revisor-gratis": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    },
    "revisor-fuerte": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    },
    "revisor-bmad": {
      "tools": {
        "codebase-memory_*": true,
        "codebase-memory_index_repository": false,
        "codebase-memory_delete_project": false,
        "codebase-memory_manage_adr": false,
        "codebase-memory_ingest_traces": false
      }
    }
  }
}

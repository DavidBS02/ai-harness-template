{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (capas gratis)",
      "options": {
        "baseURL": "{env:OMNIROUTE_BASE_URL}",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "REEMPLAZA-CON-ID-DE-DEEPSEEK-V4-NVIDIA": {
          "name": "DeepSeek V4 (NVIDIA NIM) - revisor fuerte"
        },
        "REEMPLAZA-CON-ID-DEL-COMBO-REVISOR": {
          "name": "Combo revisor: DeepSeek V4 -> Mistral Large -> Gemini Flash"
        }
      }
    }
  }
}
